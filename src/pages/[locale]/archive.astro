---
import { getAllCocktails, getPublishedCocktails } from "@/data/cocktails";
import { localeToPath, supportedLocales, type Locale } from "@/i18n/config";
import { t } from "@/i18n/ui";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { absoluteUrl, routeForLocale } from "@/utils/seo";
import { archiveStructuredData } from "@/utils/structuredData";

export function getStaticPaths() {
  return supportedLocales.map((locale) => ({
    params: { locale: localeToPath(locale) },
    props: { locale },
  }));
}

const locale = Astro.props.locale as Locale;
const cocktails = getAllCocktails(locale).slice().sort((a, b) => b.date.localeCompare(a.date));
const archiveImage = getPublishedCocktails(cocktails).find(
  (cocktail) => !cocktail.heroImageMobile.toLowerCase().endsWith(".svg"),
)?.heroImageMobile;
const path = "/archive";
const title = `${t(locale, "archive")} | ${t(locale, "siteName")}`;
const description = t(locale, "siteDescription");
const pageUrl = absoluteUrl(routeForLocale(locale, path));
const structuredData = archiveStructuredData({ locale, url: pageUrl, title, description });
---

<BaseLayout locale={locale} title={title} description={description} path={path} image={archiveImage} structuredData={structuredData}>
  <noscript>
    <style>
      [data-archive-grid][hidden] {
        display: grid !important;
      }
    </style>
  </noscript>
  <section class="archive-heading">
    <h1>{t(locale, "archive")}</h1>
    <p class="archive-intro">{t(locale, "archiveIntro")}</p>
  </section>
  <section class="archive-grid" data-archive-grid hidden>
    {
      cocktails.map((cocktail) => (
        <a
          class="archive-card"
          href={`/${localeToPath(locale)}/cocktails/${cocktail.slug}`}
          data-archive-card
          data-cocktail-id={cocktail.id}
          data-scheduled-date={cocktail.date}
        >
          <img src={cocktail.heroImageMobile} alt={`${t(locale, "visualAlt")} ${cocktail.name}`} width="1080" height="1920" />
          <div>
            <time datetime={cocktail.date}>{cocktail.date}</time>
            <h2>{cocktail.name}</h2>
            <p>{cocktail.subtitle}</p>
          </div>
        </a>
      ))
    }
  </section>
  <p class="archive-empty" data-archive-empty hidden>{t(locale, "noPastPicks")}</p>
</BaseLayout>

<script>
  const archiveGrid = document.querySelector("[data-archive-grid]");
  const archiveCards = Array.from(document.querySelectorAll("[data-archive-card]"));
  const emptyState = document.querySelector("[data-archive-empty]");
  const todayDate = new Date();
  const today = getLocalDateKey(todayDate);
  const earliestPastDate = getLocalDateKey(addLocalDays(todayDate, -14));
  const maxPastPicks = 14;
  let visibleCount = 0;

  archiveCards.forEach((card) => {
    if (!(card instanceof HTMLElement)) return;

    const scheduledDate = card.dataset.scheduledDate || "";
    const isPastPick = scheduledDate < today && scheduledDate >= earliestPastDate && visibleCount < maxPastPicks;
    card.hidden = !isPastPick;
    if (isPastPick) visibleCount += 1;
  });

  if (emptyState instanceof HTMLElement) {
    emptyState.hidden = visibleCount > 0;
  }

  if (archiveGrid instanceof HTMLElement) {
    archiveGrid.hidden = visibleCount === 0;
  }

  function getLocalDateKey(date: Date) {
    const year = date.getFullYear();
    const month = String(date.getMonth() + 1).padStart(2, "0");
    const day = String(date.getDate()).padStart(2, "0");
    return `${year}-${month}-${day}`;
  }

  function addLocalDays(date: Date, days: number) {
    const next = new Date(date);
    next.setDate(next.getDate() + days);
    return next;
  }
</script>
