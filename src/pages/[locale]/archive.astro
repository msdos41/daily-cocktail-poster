---
import { getAllCocktails } from "@/data/cocktails";
import { localeToPath, supportedLocales, type Locale } from "@/i18n/config";
import { t } from "@/i18n/ui";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { pageUrlForLocalePath } from "@/utils/seo";
import { archiveStructuredData } from "@/utils/structuredData";

export function getStaticPaths() {
  return supportedLocales.map((locale) => ({
    params: { locale: localeToPath(locale) },
    props: { locale },
  }));
}

function getLocalDateKey(date: Date) {
  const year = date.getFullYear();
  const month = String(date.getMonth() + 1).padStart(2, "0");
  const day = String(date.getDate()).padStart(2, "0");
  return `${year}-${month}-${day}`;
}

const locale = Astro.props.locale as Locale;
const cocktails = getAllCocktails(locale).slice().sort((a, b) => b.date.localeCompare(a.date));
const buildDate = new Date();
const todayKey = getLocalDateKey(buildDate);
const earliestDate = new Date(buildDate);
earliestDate.setDate(earliestDate.getDate() - 14);
const earliestPastDateKey = getLocalDateKey(earliestDate);
const maxPastPicks = 14;
const pastPickCocktails = cocktails.filter(
  (c) => c.date <= todayKey && c.date >= earliestPastDateKey,
).slice(0, maxPastPicks);
const archiveImage = pastPickCocktails.find(
  (c) => !c.heroImageMobile.toLowerCase().endsWith(".svg"),
)?.heroImageMobile;
const path = "/archive";
const title = `${t(locale, "archive")} | ${t(locale, "siteName")}`;
const description = t(locale, "siteDescription");
const pageUrl = pageUrlForLocalePath(locale, path);
const structuredData = archiveStructuredData({ locale, url: pageUrl, title, description });
const archivePayload = cocktails.map((c) => ({
  id: c.id,
  slug: c.slug,
  date: c.date,
  name: c.name,
  subtitle: c.subtitle,
  heroImageDesktop: c.heroImageDesktop,
  heroImageMobile: c.heroImageMobile,
}));
const localePrefix = `/${localeToPath(locale)}`;
const visualAltPrefix = t(locale, "visualAlt");
---

<BaseLayout locale={locale} title={title} description={description} path={path} image={archiveImage} structuredData={structuredData}>
  <script is:inline set:html={`window.__ARCHIVE_PAYLOAD__ = ${JSON.stringify(archivePayload)};window.__ARCHIVE_CONFIG__ = ${JSON.stringify({ localePrefix, visualAltPrefix })};`}></script>
  <noscript>
    <style>
      [data-archive-grid] {
        display: none !important;
      }
    </style>
  </noscript>
  <section class="archive-heading">
    <h1>{t(locale, "archive")}</h1>
    <p class="archive-intro">{t(locale, "archiveIntro")}</p>
  </section>
  <section class="archive-grid" data-archive-grid hidden></section>
  <p class="archive-empty" data-archive-empty hidden>{t(locale, "noPastPicks")}</p>
  <noscript>
    {pastPickCocktails.length > 0 ? (
      <section class="archive-grid">
        {pastPickCocktails.map((cocktail, i) => (
          <a
            class="archive-card"
            href={`/${localeToPath(locale)}/cocktails/${cocktail.slug}`}
            data-cocktail-id={cocktail.id}
            data-archive-featured={i === 0 ? "true" : undefined}
          >
            {i === 0 ? (
              <picture>
                <source media="(min-width: 721px)" srcset={cocktail.heroImageDesktop} />
                <img src={cocktail.heroImageMobile} alt={`${t(locale, "visualAlt")} ${cocktail.name}`} width="1080" height="1920" fetchpriority="high" decoding="async" />
              </picture>
            ) : (
              <img src={cocktail.heroImageMobile} alt={`${t(locale, "visualAlt")} ${cocktail.name}`} width="1080" height="1920" loading="lazy" decoding="async" />
            )}
            <div>
              <time datetime={cocktail.date}>{cocktail.date}</time>
              <h2>{cocktail.name}</h2>
              <p>{cocktail.subtitle}</p>
            </div>
          </a>
        ))}
      </section>
    ) : (
      <p class="archive-empty">{t(locale, "noPastPicks")}</p>
    )}
  </noscript>
</BaseLayout>

<script>
  interface ArchiveItem {
    id: string;
    slug: string;
    date: string;
    name: string;
    subtitle: string;
    heroImageDesktop: string;
    heroImageMobile: string;
  }

  interface ArchiveRuntimeConfig {
    localePrefix: string;
    visualAltPrefix: string;
  }

  const archiveGrid = document.querySelector<HTMLElement>("[data-archive-grid]");
  const emptyState = document.querySelector<HTMLElement>("[data-archive-empty]");
  const payload: ArchiveItem[] = (window as any).__ARCHIVE_PAYLOAD__ || [];
  const config: ArchiveRuntimeConfig = (window as any).__ARCHIVE_CONFIG__ || { localePrefix: "", visualAltPrefix: "" };
  const { localePrefix, visualAltPrefix } = config;
  const todayDate = new Date();
  const today = getLocalDateKey(todayDate);
  const earliestDate = new Date(todayDate);
  earliestDate.setDate(earliestDate.getDate() - 14);
  const earliestPastDate = getLocalDateKey(earliestDate);
  const maxPastPicks = 14;

  const visible = payload
    .filter((c: ArchiveItem) => c.date < today && c.date >= earliestPastDate)
    .sort((a: ArchiveItem, b: ArchiveItem) => b.date.localeCompare(a.date))
    .slice(0, maxPastPicks);

  if (archiveGrid) {
    if (visible.length === 0) {
      archiveGrid.hidden = true;
      if (emptyState) emptyState.hidden = false;
    } else {
      archiveGrid.hidden = false;
      archiveGrid.innerHTML = "";

      visible.forEach((cocktail: ArchiveItem, i: number) => {
        const card = document.createElement("a");
        card.className = "archive-card";
        card.href = `${localePrefix}/cocktails/${cocktail.slug}`;
        card.dataset.cocktailId = cocktail.id;

        const div = document.createElement("div");
        const time = document.createElement("time");
        time.dateTime = cocktail.date;
        time.textContent = cocktail.date;
        div.appendChild(time);

        const h2 = document.createElement("h2");
        h2.textContent = cocktail.name;
        div.appendChild(h2);

        const p = document.createElement("p");
        p.textContent = cocktail.subtitle;
        div.appendChild(p);

        if (i === 0) {
          card.dataset.archiveFeatured = "true";
          const picture = document.createElement("picture");
          const source = document.createElement("source");
          source.media = "(min-width: 721px)";
          source.srcset = cocktail.heroImageDesktop;
          picture.appendChild(source);
          const img = document.createElement("img");
          img.alt = `${visualAltPrefix} ${cocktail.name}`;
          img.src = cocktail.heroImageMobile;
          img.width = 1080;
          img.height = 1920;
          img.fetchPriority = "high";
          img.decoding = "async";
          picture.appendChild(img);
          card.appendChild(picture);
        } else {
          const img = document.createElement("img");
          img.dataset.src = cocktail.heroImageMobile;
          img.dataset.desktopSrc = cocktail.heroImageDesktop;
          img.dataset.alt = `${visualAltPrefix} ${cocktail.name}`;
          img.width = 1080;
          img.height = 1920;
          img.loading = "lazy";
          img.decoding = "async";
          img.className = "archive-img-lazy";
          card.appendChild(img);
        }

        card.appendChild(div);
        archiveGrid.appendChild(card);
      });

      const lazyImgs = archiveGrid.querySelectorAll(".archive-img-lazy");
      lazyImgs.forEach((img: Element) => {
        if (!(img instanceof HTMLImageElement)) return;
        const mobileSrc = img.dataset.src || "";
        img.alt = img.dataset.alt || "";
        img.decoding = "async";
        if (img.getAttribute("src") !== mobileSrc) {
          img.src = mobileSrc;
        }
      });

      if (emptyState) emptyState.hidden = true;
    }
  }

  function getLocalDateKey(date: Date) {
    const year = date.getFullYear();
    const month = String(date.getMonth() + 1).padStart(2, "0");
    const day = String(date.getDate()).padStart(2, "0");
    return `${year}-${month}-${day}`;
  }
</script>
