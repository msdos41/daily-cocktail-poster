---
import ImmersiveCocktail from "@/components/ImmersiveCocktail.astro";
import { getAllCocktails, getDailyCocktail } from "@/data/cocktails";
import { localeToPath, supportedLocales, type Locale } from "@/i18n/config";
import { t } from "@/i18n/ui";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { absoluteUrl, routeForLocale } from "@/utils/seo";
import { homeStructuredData } from "@/utils/structuredData";

export function getStaticPaths() {
  return supportedLocales.map((locale) => ({
    params: { locale: localeToPath(locale) },
    props: { locale },
  }));
}

const locale = Astro.props.locale as Locale;
const cocktail = getDailyCocktail(locale);
const dailyCocktails = getAllCocktails(locale);
const currentPath = "/";
const title = t(locale, "siteName");
const description = t(locale, "siteDescription");
const pageUrl = absoluteUrl(routeForLocale(locale, currentPath));
const structuredData = homeStructuredData({ locale, url: pageUrl, title, description });
---

<BaseLayout locale={locale} title={title} description={description} path={currentPath} structuredData={structuredData} immersive>
  <ImmersiveCocktail cocktail={cocktail} dailyCocktails={dailyCocktails} locale={locale} path={currentPath} />
</BaseLayout>
