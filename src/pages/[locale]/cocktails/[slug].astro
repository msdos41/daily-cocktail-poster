---
import ImmersiveCocktail from "@/components/ImmersiveCocktail.astro";
import { getCocktail, getCocktailSlugs, type Cocktail } from "@/data/cocktails";
import { localeToPath, supportedLocales, type Locale } from "@/i18n/config";
import { t } from "@/i18n/ui";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { pageUrlForLocalePath } from "@/utils/seo";
import { cocktailStructuredData } from "@/utils/structuredData";

export function getStaticPaths() {
  return supportedLocales.flatMap((locale) =>
    getCocktailSlugs().map((slug) => ({
      params: { locale: localeToPath(locale), slug },
      props: { locale, slug },
    })),
  );
}

const locale = Astro.props.locale as Locale;
const slug = Astro.props.slug as string;
const cocktail = getCocktail(locale, slug);

if (!cocktail) {
  return Astro.redirect(`/${localeToPath(locale)}/`);
}

function recipeTitle(locale: Locale, cocktail: Cocktail) {
  const suffix = t(locale, "cocktailRecipeTitleSuffix");
  return locale === "zh-CN" ? `${cocktail.name}${suffix}` : `${cocktail.name} ${suffix}`;
}

function recipeDescription(locale: Locale, cocktail: Cocktail) {
  const suffix = t(locale, "cocktailRecipeDescriptionSuffix");
  return locale === "zh-CN" ? `${cocktail.description}${suffix}` : `${cocktail.description} ${suffix}`;
}


const path = `/cocktails/${cocktail.slug}`;
const pageRecipeTitle = recipeTitle(locale, cocktail);
const title = `${pageRecipeTitle} | ${t(locale, "siteName")}`;
const description = recipeDescription(locale, cocktail);
const pageUrl = pageUrlForLocalePath(locale, path);
const structuredData = cocktailStructuredData({ locale, cocktail, url: pageUrl });

const relatedCocktails = (cocktail.relatedSlugs || [])
  .map((relatedSlug) => getCocktail(locale, relatedSlug))
  .filter((c): c is Cocktail => Boolean(c));
---

<BaseLayout
  locale={locale}
  title={title}
  description={description}
  path={path}
  image={cocktail.ogImage || cocktail.posterImage}
  ogType="article"
  structuredData={structuredData}
  immersive
  immersiveScrollable
>
  <ImmersiveCocktail cocktail={cocktail} locale={locale} path={path} variant="detail" recipeMode="scroll" recipeTargetId="detail-recipe" />
  <section class="detail-recipe-stage" id="detail-recipe" aria-labelledby="detail-recipe-title">
    <div class="detail-recipe-inner">
      <nav class="detail-breadcrumbs" aria-label="Breadcrumb">
        <ol>
          <li><a href={`/${localeToPath(locale)}/`}>{t(locale, "home")}</a></li>
          <li class="separator" aria-hidden="true">/</li>
          <li><a href={`/${localeToPath(locale)}/cocktails/`}>{t(locale, "theCollection")}</a></li>
          <li class="separator" aria-hidden="true">/</li>
          <li aria-current="page">{cocktail.name}</li>
        </ol>
      </nav>
      <div class="detail-recipe-layout">
        <div class="detail-recipe-summary">
          <h2 class="sr-only" id="detail-recipe-title">{t(locale, "openRecipe")}</h2>
          <p class="detail-recipe-description">{cocktail.description}</p>
          <dl class="detail-recipe-facts">
            <div>
              <dt>{t(locale, "baseSpirit")}</dt>
              <dd>{cocktail.baseSpirit}</dd>
            </div>
            <div>
              <dt>{t(locale, "glass")}</dt>
              <dd>{cocktail.glass}</dd>
            </div>
            <div>
              <dt>{t(locale, "garnish")}</dt>
              <dd>{cocktail.garnish}</dd>
            </div>
            <div>
              <dt>{t(locale, "flavor")}</dt>
              <dd>{cocktail.flavor}</dd>
            </div>
          </dl>
          <div class="detail-recipe-tags" aria-label="Tags">
            {cocktail.tags.map((tag) => <span>{tag}</span>)}
          </div>
        </div>
        <div class="detail-recipe-columns">
          <section class="detail-recipe-column">
            <h3>{t(locale, "ingredients")}</h3>
            <ul class="ingredient-list">
              {cocktail.ingredients.map((ingredient) => <li>{ingredient}</li>)}
            </ul>
          </section>
          <section class="detail-recipe-column">
            <h3>{t(locale, "howToMake")}</h3>
            <ol class="steps-list">
              {cocktail.steps.map((step, index) => <li id={`recipe-step-${index + 1}`}>{step}</li>)}
            </ol>
          </section>
        </div>
      </div>

      {cocktail.originLore && (
        <section class="detail-editorial-section" aria-label={t(locale, "loreAndFaqAria")}>
          <div class="editorial-capsule">
            <h3 class="editorial-heading">{t(locale, "originLoreTitle")}</h3>
            <p class="editorial-text">{cocktail.originLore}</p>
          </div>

          <div class="editorial-capsule">
            <h3 class="editorial-heading">{t(locale, "craftProfileTitle")}</h3>
            <p class="editorial-flavor-lead">
              <strong>{t(locale, "tastingNotesLabel")}</strong>
              {cocktail.flavorNotes}
            </p>
            {cocktail.barTips && cocktail.barTips.length > 0 && (
              <div class="editorial-tips">
                <span class="editorial-tips-label">{t(locale, "bartenderSecrets")}</span>
                <ul>
                  {cocktail.barTips.map((tip) => (
                    <li>{tip}</li>
                  ))}
                </ul>
              </div>
            )}
          </div>

          {cocktail.faqs && cocktail.faqs.length > 0 && (
            <div class="editorial-capsule">
              <h3 class="editorial-heading">{t(locale, "faqTitle")}</h3>
              <div class="faq-list">
                {cocktail.faqs.map((faq) => (
                  <details class="faq-item">
                    <summary class="faq-question">
                      <span>{faq.question}</span>
                      <span class="faq-icon" aria-hidden="true">+</span>
                    </summary>
                    <p class="faq-answer">{faq.answer}</p>
                  </details>
                ))}
              </div>
            </div>
          )}
        </section>
      )}

      {relatedCocktails.length > 0 && (
        <section class="detail-sister-shelf" aria-labelledby="sister-shelf-title">
          <div class="sister-shelf-header">
            <span class="editorial-kicker">{t(locale, "sisterPoursSubtitle")}</span>
            <h3 id="sister-shelf-title">{t(locale, "sisterPoursTitle")}</h3>
          </div>
          <div class="sister-cards">
            {relatedCocktails.map((related) => (
              <a href={`/${localeToPath(locale)}/cocktails/${related.slug}`} class="sister-card">
                <img
                  src={related.heroImageDesktop}
                  alt={`${t(locale, "visualAlt")} ${related.name}`}
                  width="480"
                  height="270"
                  loading="lazy"
                  decoding="async"
                  class="sister-card-img"
                />
                <div class="sister-card-meta">
                  <span class="sister-card-spirit">{related.baseSpirit}</span>
                  <h4 class="sister-card-title">{related.name}</h4>
                  <p class="sister-card-subtitle">{related.subtitle}</p>
                </div>
              </a>
            ))}
          </div>
        </section>
      )}
    </div>
  </section>
</BaseLayout>
