---
import UtilityTopbar from "@/components/UtilityTopbar.astro";
import { localeToPath, type Locale } from "@/i18n/config";
import { t } from "@/i18n/ui";
import Mail from "lucide-astro/Mail";
import { contactEmail, xHandle } from "@/data/infoPages";
import type { JsonLd } from "@/utils/structuredData";
import {
  alternateLinks,
  alternateOpenGraphLocales,
  openGraphLocale,
  pageUrlForLocalePath,
  socialImageMetadata,
} from "@/utils/seo";
import "@/styles/global.css";

type Props = {
  locale: Locale;
  title: string;
  description: string;
  path: string;
  image?: string;
  immersive?: boolean;
  ogType?: "website" | "article";
  structuredData?: JsonLd | JsonLd[];
};

const {
  locale,
  title,
  description,
  path,
  image = "/images/og-default-v2.jpg",
  immersive = false,
  ogType = "website",
  structuredData,
} = Astro.props;
const googleAnalyticsId = "G-RLJPSW8NWV";
const alternates = alternateLinks(path);
const canonical = pageUrlForLocalePath(locale, path);
const socialImage = socialImageMetadata(image);
const imageAlt = title;
const structuredDataItems = structuredData ? (Array.isArray(structuredData) ? structuredData : [structuredData]) : [];
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#15120f" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="canonical" href={canonical} />
    {alternates.map((item) => <link rel="alternate" hreflang={item.locale} href={item.href} />)}
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={t(locale, "siteName")} />
    <meta property="og:locale" content={openGraphLocale(locale)} />
    {alternateOpenGraphLocales(locale).map((item) => <meta property="og:locale:alternate" content={item} />)}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage.url} />
    <meta property="og:image:secure_url" content={socialImage.url} />
    <meta property="og:image:type" content={socialImage.type} />
    {socialImage.width && <meta property="og:image:width" content={String(socialImage.width)} />}
    {socialImage.height && <meta property="og:image:height" content={String(socialImage.height)} />}
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage.url} />
    <meta name="twitter:image:alt" content={imageAlt} />
    <title>{title}</title>
    {structuredDataItems.map((item) => <script is:inline type="application/ld+json" set:html={JSON.stringify(item)} />)}
    <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${googleAnalyticsId}`}></script>
    <script
      is:inline
      set:html={`window.dataLayer = window.dataLayer || [];
function gtag() {
  window.dataLayer.push(arguments);
}
gtag("js", new Date());
gtag("config", "${googleAnalyticsId}");`}
    />
  </head>
  <body class:list={[immersive ? "immersive-page" : "standard-page"]}>
    {
      !immersive && <UtilityTopbar locale={locale} path={path} />
    }
    <main class:list={[immersive && "immersive-main"]}>
      <slot />
    </main>
    {
      !immersive && (
        <footer class="site-footer">
          <div>
            <span>{t(locale, "siteName")}</span>
            <span class="footer-tagline">{t(locale, "responsibleDrinking")}</span>
          </div>
          <nav class="footer-nav">
            <a href={`/${localeToPath(locale)}/archive`}>{t(locale, "pastPicks")}</a>
            <a href={`/${localeToPath(locale)}/about`}>{t(locale, "about")}</a>
            <a href={`/${localeToPath(locale)}/privacy`}>{t(locale, "privacy")}</a>
            <a href={`mailto:${contactEmail}`} class="icon-link" aria-label={t(locale, "email")}>
              <Mail size={18} aria-hidden="true" />
            </a>
            <a href={`https://x.com/${xHandle}`} target="_blank" rel="noopener noreferrer" class="icon-link" aria-label={t(locale, "xProfile")}>
              <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true">
                <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z" />
              </svg>
            </a>
          </nav>
        </footer>
      )
    }
    <script is:inline>
      document.querySelectorAll("[data-share-url]").forEach((button) => {
        button.addEventListener("click", async () => {
          const url = button.getAttribute("data-share-url");
          const title = button.getAttribute("data-share-title") || document.title;
          const copied = button.getAttribute("data-copied-label") || "Copied";

          if (navigator.share) {
            await navigator.share({ title, url });
            return;
          }

          await navigator.clipboard.writeText(url);
          const original = button.textContent;
          button.textContent = copied;
          window.setTimeout(() => {
            button.textContent = original;
          }, 1600);
        });
      });
    </script>
  </body>
</html>
