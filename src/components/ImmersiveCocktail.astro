---
import ChevronDown from "lucide-astro/ChevronDown";
import ChevronUp from "lucide-astro/ChevronUp";
import Download from "lucide-astro/Download";
import Share2 from "lucide-astro/Share2";
import XIcon from "lucide-astro/X";
import UtilityTopbar from "@/components/UtilityTopbar.astro";
import type { Cocktail } from "@/data/cocktails";
import { type Locale } from "@/i18n/config";
import { t } from "@/i18n/ui";
import { publicHomeUrl, shareUrlForLocalePath } from "@/utils/seo";

type Props = {
  cocktail: Cocktail;
  dailyCocktails?: Cocktail[];
  locale: Locale;
  path: string;
  recipeMode?: "dialog" | "scroll";
  recipeTargetId?: string;
  variant?: "home" | "detail";
};

const { cocktail, dailyCocktails, locale, path, recipeMode = "dialog", recipeTargetId, variant = "detail" } = Astro.props;
const usesRecipeDialog = recipeMode === "dialog";
const usesRecipeScroll = recipeMode === "scroll";

const extname = (path: string): string => {
  const i = path.lastIndexOf(".");
  return i >= 0 ? path.substring(i) : "";
};
const monthLabels = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];
const formatMetadataDate = (date: string) => {
  const [, month = "", day = ""] = date.split("-");
  if (locale === "zh-CN") return `${month}.${day}`;
  return `${monthLabels[Number(month) - 1] ?? month} ${day}`;
};
const heroMetadataLabel = t(locale, variant === "home" ? "dailyPour" : "pourNotes");
const heroMetadata = `${heroMetadataLabel} · ${formatMetadataDate(cocktail.date)}`;
const heroIngredientSummary = cocktail.heroIngredients.join(" · ");
const shareUrl = shareUrlForLocalePath(locale, path);
const sharePayload = {
  name: cocktail.name,
  filenameBase: cocktail.slug,
  shareUrl,
};
const shareXTooltip = "X";
const shareRedditTooltip = "Reddit";
const shareOnXLabel = locale === "zh-CN" ? "分享到 X" : "Share on X";
const shareOnRedditLabel = locale === "zh-CN" ? "分享到 Reddit" : "Share on Reddit";
const xShareCopiedToast =
  locale === "zh-CN" ? "分享文案已复制。如果 X 输入框为空，请直接粘贴。" : "Post copied. If X opens empty, paste it.";
const xShareReadyToast =
  locale === "zh-CN"
    ? "X 已打开。如果输入框为空，请手动粘贴当前页面链接。"
    : "X opened. If it is empty, paste this page link manually.";
const dailyCocktailPayload = dailyCocktails?.map((item) => ({
  ...item,
  heroIngredientSummary: item.heroIngredients.join(" · "),
}));
const dailyCocktailPrepaintScript = `
(() => {
  const locale = ${JSON.stringify(locale)};
  const metadataLabel = ${JSON.stringify(t(locale, "dailyPour"))};
  const monthLabels = ${JSON.stringify(monthLabels)};
  const dailyCocktailsNode = document.querySelector("[data-daily-cocktails]");
  if (!dailyCocktailsNode) return;

  let cocktails = [];
  try {
    cocktails = JSON.parse(dailyCocktailsNode.textContent || "[]");
  } catch {
    return;
  }

  const today = getLocalDateKey(new Date());
  const scheduled = cocktails.slice().sort((a, b) => a.date.localeCompare(b.date));
  const published = scheduled.filter((item) => item.date <= today);
  const cocktail =
    scheduled.find((item) => item.date === today) ||
    published[published.length - 1] ||
    scheduled[0];

  if (!cocktail) return;

  const stage = document.querySelector(".immersive-stage");
  if (stage) {
    stage.setAttribute("data-cocktail-id", cocktail.id);
    stage.setAttribute("data-desktop-download", cocktail.backgroundDownloadDesktop);
    stage.setAttribute("data-mobile-download", cocktail.backgroundDownloadMobile);
  }

  const source = document.querySelector(".immersive-bg source");
  const image = document.querySelector(".immersive-bg img");
  if (source) source.setAttribute("srcset", cocktail.heroImageMobile);
  if (image) {
    image.setAttribute("src", cocktail.heroImageDesktop);
    const altPrefix = image.getAttribute("data-poster-alt-prefix") || "";
    image.setAttribute("alt", (altPrefix + " " + cocktail.name).trim());
  }

  setAllText("[data-cocktail-name]", cocktail.name);
  setText("[data-hero-metadata]", formatHeroMetadata(cocktail.date));
  setText("[data-cocktail-subtitle]", cocktail.subtitle);
  setText("[data-hero-ingredients]", cocktail.heroIngredientSummary);

  const sharePayloadNode = document.querySelector("[data-share-payload]");
  if (sharePayloadNode) {
    try {
      const sharePayload = JSON.parse(sharePayloadNode.textContent || "{}");
      sharePayload.name = cocktail.name;
      sharePayload.filenameBase = cocktail.slug;
      sharePayloadNode.textContent = JSON.stringify(sharePayload);
    } catch {
      return;
    }
  }

  const downloadLink = document.querySelector("[data-download-background]");
  const isMobile = window.matchMedia("(max-width: 720px)").matches;
  const downloadHref = isMobile ? cocktail.backgroundDownloadMobile : cocktail.backgroundDownloadDesktop;
  if (downloadLink && downloadHref) {
    downloadLink.setAttribute("href", downloadHref);
    const dlExt = downloadHref.includes(".") ? downloadHref.substring(downloadHref.lastIndexOf(".")) : ".svg";
    downloadLink.setAttribute(
      "download",
      cocktail.slug + "-" + (isMobile ? "mobile" : "desktop") + "-background" + dlExt,
    );
  }

  function getLocalDateKey(date) {
    const year = date.getFullYear();
    const month = String(date.getMonth() + 1).padStart(2, "0");
    const day = String(date.getDate()).padStart(2, "0");
    return year + "-" + month + "-" + day;
  }

  function formatHeroMetadata(dateKey) {
    const parts = dateKey.split("-");
    const month = parts[1] || "";
    const day = parts[2] || "";
    const formattedDate = locale === "zh-CN" ? month + "." + day : (monthLabels[Number(month) - 1] || month) + " " + day;
    return metadataLabel + " · " + formattedDate;
  }

  function setText(selector, value) {
    const element = document.querySelector(selector);
    if (element) element.textContent = value;
  }

  function setAllText(selector, value) {
    document.querySelectorAll(selector).forEach((element) => {
      element.textContent = value;
    });
  }
})();
`;

---

<section
  class="immersive-stage"
  data-cocktail-id={cocktail.id}
  data-hero-variant={variant}
  data-desktop-download={cocktail.backgroundDownloadDesktop}
  data-mobile-download={cocktail.backgroundDownloadMobile}
  data-fallback-share-url={publicHomeUrl()}
>
  <picture class="immersive-bg">
    <source media="(max-width: 720px)" srcset={cocktail.heroImageMobile} />
    <img
      src={cocktail.heroImageDesktop}
      alt={`${t(locale, "visualAlt")} ${cocktail.name}`}
      data-poster-alt-prefix={t(locale, "visualAlt")}
    />
  </picture>
  <div class="immersive-shade" aria-hidden="true"></div>

  <UtilityTopbar locale={locale} path={path} overlay />

  <div class="immersive-copy">
    <p
      class="hero-kicker"
      data-hero-metadata
      data-metadata-label={heroMetadataLabel}
      data-metadata-locale={locale}
    >
      {heroMetadata}
    </p>
    <h1 data-cocktail-name data-hero-title>{cocktail.name}</h1>
    <p class="immersive-subtitle" data-cocktail-subtitle>{cocktail.subtitle}</p>
    <p class="hero-ingredients" aria-label={t(locale, "keyIngredients")}>
      <span data-hero-ingredients>{heroIngredientSummary}</span>
    </p>
  </div>

  <div class="floating-actions" aria-label={t(locale, "share")}>

    <div class="share-action" data-share-action>
      <button
        class="icon-button action-button"
        type="button"
        data-open-share
        aria-controls="share-tray"
        aria-expanded="false"
        data-tooltip={t(locale, "share")}
        aria-label={t(locale, "share")}
      >
        <Share2 size={20} aria-hidden="true" />
      </button>
      <div class="share-tray" id="share-tray" data-share-tray hidden>
        <button
          class="share-target share-target-x"
          type="button"
          data-share-target="x"
          data-tooltip={shareXTooltip}
          aria-label={shareOnXLabel}
        >
          <svg class="share-brand-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path
              fill="currentColor"
              d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24h-6.657l-5.214-6.817-5.966 6.817H1.68l7.73-8.835L1.254 2.25h6.826l4.713 6.231 5.451-6.231Zm-1.161 17.52h1.833L7.084 4.126H5.117L17.083 19.77Z"
            />
          </svg>
        </button>
        <button
          class="share-target share-target-reddit"
          type="button"
          data-share-target="reddit"
          data-tooltip={shareRedditTooltip}
          aria-label={shareOnRedditLabel}
        >
          <svg class="share-brand-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path
              fill="currentColor"
              d="M12 0C5.373 0 0 5.373 0 12s5.373 12 12 12 12-5.373 12-12S18.627 0 12 0Zm5.011 4.744a1.25 1.25 0 0 1 .006 2.498c-.51 0-.95-.306-1.145-.744l-2.62-.558-.696 3.277c1.758.081 3.35.636 4.505 1.47a1.75 1.75 0 1 1 1.93 2.88c.034.218.052.44.052.666 0 2.771-3.155 5.019-7.043 5.019s-7.043-2.248-7.043-5.019c0-.225.018-.448.053-.666a1.75 1.75 0 1 1 1.93-2.88c1.154-.834 2.747-1.389 4.504-1.47l.84-3.957a.55.55 0 0 1 .652-.424l3.139.668c.229-.461.704-.78 1.256-.78ZM8.76 13.11a1.204 1.204 0 1 0 0 2.408 1.204 1.204 0 0 0 0-2.408Zm6.48 0a1.204 1.204 0 1 0 0 2.408 1.204 1.204 0 0 0 0-2.408Zm-6.053 4.18a.36.36 0 0 0-.255.616c.688.688 1.698 1.023 3.068 1.023 1.37 0 2.38-.335 3.068-1.023a.36.36 0 1 0-.51-.51c-.54.54-1.36.81-2.558.81-1.197 0-2.017-.27-2.558-.81a.36.36 0 0 0-.255-.106Z"
            />
          </svg>
        </button>
      </div>
    </div>
    <a
      class="icon-button action-button"
      href={cocktail.backgroundDownloadDesktop}
      download={`${cocktail.slug}-background${extname(cocktail.backgroundDownloadDesktop)}`}
      data-download-background
      data-tooltip={t(locale, "downloadBackgroundLabel")}
      aria-label={t(locale, "downloadBackgroundLabel")}
    >
      <Download size={20} aria-hidden="true" />
    </a>
  </div>
  <div
    class="share-toast"
    data-share-toast
    data-copied-message={xShareCopiedToast}
    data-ready-message={xShareReadyToast}
    hidden
    aria-live="polite"
    aria-atomic="true"
  ></div>

  <button
    class:list={["recipe-handle", usesRecipeScroll && "recipe-scroll-handle"]}
    type="button"
    data-open-recipe={usesRecipeDialog ? "" : undefined}
    data-scroll-recipe={usesRecipeScroll ? "" : undefined}
    data-scroll-target={usesRecipeScroll ? recipeTargetId : undefined}
    aria-haspopup={usesRecipeDialog ? "dialog" : undefined}
    aria-controls={usesRecipeDialog ? "recipe-dialog" : recipeTargetId}
    aria-expanded={usesRecipeDialog ? "false" : undefined}
    aria-label={t(locale, "openRecipe")}
    data-tooltip={t(locale, "openRecipe")}
  >
    {usesRecipeScroll ? <ChevronDown size={20} aria-hidden="true" /> : <ChevronUp size={20} aria-hidden="true" />}
  </button>

  {
    usesRecipeDialog && (
      <dialog class="recipe-dialog" id="recipe-dialog" data-recipe-dialog aria-labelledby="recipe-dialog-title">
        <article class="recipe-sheet">
          <form class="recipe-sheet-header">
            <div>
              <p class="eyebrow">{t(locale, "recipeDetails")}</p>
              <h2 data-cocktail-name id="recipe-dialog-title">{cocktail.name}</h2>
            </div>
            <button class="icon-close" type="button" data-close-recipe aria-label={t(locale, "closeRecipe")}>
              <XIcon size={20} aria-hidden="true" />
            </button>
          </form>
          <div class="recipe-sheet-content">
            <p class="recipe-description" data-recipe-description>{cocktail.description}</p>

            <dl class="recipe-meta-grid">
              <div>
                <dt>{t(locale, "flavor")}</dt>
                <dd data-recipe-flavor>{cocktail.flavor}</dd>
              </div>
              <div>
                <dt>{t(locale, "glass")}</dt>
                <dd data-recipe-glass>{cocktail.glass}</dd>
              </div>
              <div>
                <dt>{t(locale, "garnish")}</dt>
                <dd data-recipe-garnish>{cocktail.garnish}</dd>
              </div>
              <div>
                <dt>{t(locale, "baseSpirit")}</dt>
                <dd data-recipe-base-spirit>{cocktail.baseSpirit}</dd>
              </div>
            </dl>

            <section class="recipe-section-ingredients">
              <h3>{t(locale, "ingredients")}</h3>
              <ul data-recipe-ingredients>
                {cocktail.ingredients.map((ingredient) => <li>{ingredient}</li>)}
              </ul>
            </section>
            <section class="recipe-section-steps">
              <h3>{t(locale, "howToMake")}</h3>
              <ol data-recipe-steps>
                {cocktail.steps.map((step, index) => <li id={`recipe-step-${index + 1}`}>{step}</li>)}
              </ol>
            </section>

            <div class="tag-row recipe-tags" aria-label="Tags" data-recipe-tags>
              {cocktail.tags.map((tag) => <span>{tag}</span>)}
            </div>
          </div>
        </article>
      </dialog>
    )
  }

  <script is:inline type="application/json" data-share-payload set:html={JSON.stringify(sharePayload)} />
  {
    dailyCocktailPayload && (
      <script is:inline type="application/json" data-daily-cocktails set:html={JSON.stringify(dailyCocktailPayload)} />
    )
  }
  {dailyCocktailPayload && <script is:inline set:html={dailyCocktailPrepaintScript} />}
</section>

<script>
  const stage = document.querySelector(".immersive-stage");
  const fallbackShareUrl =
    stage instanceof HTMLElement ? stage.dataset.fallbackShareUrl || window.location.href : window.location.href;
  const recipeDialog = document.querySelector("[data-recipe-dialog]");
  const openShare = document.querySelector("[data-open-share]");
  const openRecipe = document.querySelector("[data-open-recipe]");
  const scrollRecipe = document.querySelector("[data-scroll-recipe]");
  const shareAction = document.querySelector("[data-share-action]");
  const shareTray = document.querySelector("[data-share-tray]");
  const shareToast = document.querySelector("[data-share-toast]");
  const heroTitle = document.querySelector("[data-hero-title]");
  const heroMetadata = document.querySelector("[data-hero-metadata]");
  const sharePayloadNode = document.querySelector("[data-share-payload]");
  const dailyCocktailsNode = document.querySelector("[data-daily-cocktails]");
  type SharePayload = {
    name: string;
    filenameBase: string;
    shareUrl: string;
  };

  type DailyCocktailPayload = {
    id: string;
    date: string;
    slug: string;
    name: string;
    subtitle: string;
    description: string;
    heroIngredientSummary: string;
    ingredients: string[];
    steps: string[];
    tags: string[];
    flavor: string;
    glass: string;
    garnish: string;
    baseSpirit: string;
    heroImageDesktop: string;
    heroImageMobile: string;
    backgroundDownloadDesktop: string;
    backgroundDownloadMobile: string;
  };

  let currentSharePayload = (sharePayloadNode ? JSON.parse(sharePayloadNode.textContent || "{}") : {}) as SharePayload;
  const dailyCocktails = (dailyCocktailsNode
    ? JSON.parse(dailyCocktailsNode.textContent || "[]")
    : []) as DailyCocktailPayload[];
  const isMobileMedia = window.matchMedia("(max-width: 720px)");
  let heroTitleFrame = 0;
  let shareToastTimer = 0;

  function updateDownloadTarget() {
    const link = document.querySelector("[data-download-background]");
    if (!link || !stage) return;

    const href = isMobileMedia.matches
      ? stage.getAttribute("data-mobile-download")
      : stage.getAttribute("data-desktop-download");

    if (href) {
      link.setAttribute("href", href);
      const dlExt = href.includes(".") ? href.substring(href.lastIndexOf(".")) : ".svg";
      link.setAttribute(
        "download",
        `${currentSharePayload.filenameBase || "cocktail"}-${isMobileMedia.matches ? "mobile" : "desktop"}-background${dlExt}`,
      );
    }
  }

  if (dailyCocktails.length) {
    applyDailyCocktail(pickDailyCocktail(dailyCocktails, new Date()));
  }

  configureHeroTitle();
  updateDownloadTarget();
  isMobileMedia.addEventListener("change", updateDownloadTarget);
  window.addEventListener("resize", scheduleFitHeroTitle);
  document.fonts?.ready.then(scheduleFitHeroTitle);

  openShare?.addEventListener("click", (event) => {
    event.stopPropagation();
    if (isShareTrayOpen()) {
      closeShareTray();
    } else {
      openShareTray();
    }
  });

  openRecipe?.addEventListener("click", openRecipeDialog);
  scrollRecipe?.addEventListener("click", scrollToRecipe);

  recipeDialog?.addEventListener("click", (event) => {
    if (event.target === recipeDialog) {
      closeRecipeDialog();
    }
  });

  document.querySelector("[data-close-recipe]")?.addEventListener("click", closeRecipeDialog);

  recipeDialog?.addEventListener("cancel", (event) => {
    event.preventDefault();
    closeRecipeDialog();
  });

  const utilityMenus = Array.from(document.querySelectorAll(".utility-menu")).filter(
    (menu): menu is HTMLDetailsElement => menu instanceof HTMLDetailsElement,
  );

  document.addEventListener("click", (event) => {
    const target = event.target;
    if (!(target instanceof Node)) return;

    if (shareAction?.contains(target)) {
      return;
    }

    if (utilityMenus.some((menu) => menu.contains(target))) {
      closeShareTray();
      return;
    }

    closeShareTray();
    utilityMenus.forEach((menu) => menu.removeAttribute("open"));
  });

  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape") {
      closeShareTray();
    }
  });

  document.querySelectorAll("[data-share-target]").forEach((button) => {
    button.addEventListener("click", () => {
      if (!(button instanceof HTMLElement)) return;
      const target = button.dataset.shareTarget || "";

      if (target === "x") {
        openXShareIntent();
      } else if (target === "reddit") {
        openRedditShareIntent();
      }
      closeShareTray();
    });
  });

  function openXShareIntent() {
    const intentUrl = new URL("https://twitter.com/intent/tweet");
    intentUrl.searchParams.set("text", buildXPostText());

    copyTextToClipboard(buildXClipboardText()).then((copied) => {
      showShareToast(copied ? "data-copied-message" : "data-ready-message");
    });
    window.open(intentUrl.toString(), "_blank", "noopener,noreferrer");
  }

  function openRedditShareIntent() {
    const redditUrl = new URL("https://www.reddit.com/submit");
    redditUrl.searchParams.set("url", getCanonicalShareUrl());
    redditUrl.searchParams.set("title", buildRedditTitle());
    window.open(redditUrl.toString(), "_blank", "noopener,noreferrer");
  }

  function buildXPostText() {
    return [
      `Today's cocktail recommendation: ${currentSharePayload.name}.`,
      "A daily cocktail poster site: one drink, one visual, every day.",
      getCanonicalShareUrl(),
      "#JustOneSip #Cocktails #Mixology",
    ].join("\n\n");
  }

  function buildXClipboardText() {
    return buildXPostText();
  }

  function buildRedditTitle() {
    return `Today's cocktail recommendation: ${currentSharePayload.name} | Just One Sip`;
  }

  function getCanonicalShareUrl() {
    return currentSharePayload.shareUrl || fallbackShareUrl;
  }

  async function copyTextToClipboard(text: string) {
    try {
      if (!navigator.clipboard) return false;
      await navigator.clipboard.writeText(text);
      return true;
    } catch {
      return false;
    }
  }

  function openShareTray() {
    hideShareToast();
    utilityMenus.forEach((menu) => menu.removeAttribute("open"));
    if (shareTray instanceof HTMLElement) {
      shareTray.hidden = false;
    }
    if (openShare instanceof HTMLElement) {
      openShare.setAttribute("aria-expanded", "true");
    }
  }

  function closeShareTray() {
    if (shareTray instanceof HTMLElement) {
      shareTray.hidden = true;
    }
    if (openShare instanceof HTMLElement) {
      openShare.setAttribute("aria-expanded", "false");
    }
  }

  function isShareTrayOpen() {
    return shareTray instanceof HTMLElement && !shareTray.hidden;
  }

  function showShareToast(messageAttribute: "data-copied-message" | "data-ready-message") {
    if (!(shareToast instanceof HTMLElement)) return;

    shareToast.textContent = shareToast.getAttribute(messageAttribute) || "";
    shareToast.hidden = false;
    window.clearTimeout(shareToastTimer);
    shareToastTimer = window.setTimeout(() => {
      shareToast.hidden = true;
    }, 3400);
  }

  function hideShareToast() {
    if (shareToast instanceof HTMLElement) {
      shareToast.hidden = true;
    }
    window.clearTimeout(shareToastTimer);
  }

  function openRecipeDialog() {
    if (!(recipeDialog instanceof HTMLDialogElement) || recipeDialog.open) return;
    recipeDialog.removeAttribute("data-closing");
    recipeDialog.showModal();
    openRecipe?.setAttribute("aria-expanded", "true");
  }

  function closeRecipeDialog() {
    if (!(recipeDialog instanceof HTMLDialogElement) || !recipeDialog.open) return;
    if (recipeDialog.hasAttribute("data-closing")) return;
    recipeDialog.setAttribute("data-closing", "");
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
      recipeDialog.close();
      recipeDialog.removeAttribute("data-closing");
      openRecipe?.setAttribute("aria-expanded", "false");
      return;
    }
    const finish = () => {
      recipeDialog.removeEventListener("animationend", onEnd);
      clearTimeout(fallbackTimer);
      recipeDialog.close();
      recipeDialog.removeAttribute("data-closing");
      openRecipe?.setAttribute("aria-expanded", "false");
    };
    const onEnd = (event: AnimationEvent) => {
      if (event.target !== recipeDialog) return;
      finish();
    };
    recipeDialog.addEventListener("animationend", onEnd);
    const fallbackTimer = window.setTimeout(finish, 300);
  }

  function pickDailyCocktail(cocktails: DailyCocktailPayload[], date: Date) {
    const today = getLocalDateKey(date);
    const scheduled = cocktails.slice().sort((a, b) => a.date.localeCompare(b.date));
    const exact = scheduled.find((cocktail) => cocktail.date === today);
    if (exact) return exact;

    const published = scheduled.filter((cocktail) => cocktail.date <= today);
    return published[published.length - 1] ?? scheduled[0];
  }

  function getLocalDateKey(date: Date) {
    const year = date.getFullYear();
    const month = String(date.getMonth() + 1).padStart(2, "0");
    const day = String(date.getDate()).padStart(2, "0");
    return `${year}-${month}-${day}`;
  }

  function applyDailyCocktail(cocktail: DailyCocktailPayload) {
    if (!stage) return;

    stage.setAttribute("data-cocktail-id", cocktail.id);
    stage.setAttribute("data-desktop-download", cocktail.backgroundDownloadDesktop);
    stage.setAttribute("data-mobile-download", cocktail.backgroundDownloadMobile);

    const source = document.querySelector(".immersive-bg source");
    const image = document.querySelector(".immersive-bg img");
    if (source) source.setAttribute("srcset", cocktail.heroImageMobile);
    if (image) {
      image.setAttribute("src", cocktail.heroImageDesktop);
      const altPrefix = image.getAttribute("data-poster-alt-prefix") || "";
      image.setAttribute("alt", `${altPrefix} ${cocktail.name}`.trim());
    }

    setAllText("[data-cocktail-name]", cocktail.name);
    setText("[data-hero-metadata]", formatHeroMetadata(cocktail.date));
    setText("[data-cocktail-subtitle]", cocktail.subtitle);
    setText("[data-hero-ingredients]", cocktail.heroIngredientSummary);
    setText("[data-recipe-description]", cocktail.description);
    setText("[data-recipe-flavor]", cocktail.flavor);
    setText("[data-recipe-glass]", cocktail.glass);
    setText("[data-recipe-garnish]", cocktail.garnish);
    setText("[data-recipe-base-spirit]", cocktail.baseSpirit);
    replaceList("[data-recipe-tags]", cocktail.tags, "span");
    replaceList("[data-recipe-ingredients]", cocktail.ingredients, "li");
    replaceList("[data-recipe-steps]", cocktail.steps, "li");

    currentSharePayload = {
      ...currentSharePayload,
      name: cocktail.name,
      filenameBase: cocktail.slug,
    };

    if (sharePayloadNode) {
      sharePayloadNode.textContent = JSON.stringify(currentSharePayload);
    }

    configureHeroTitle();
    updateDownloadTarget();
  }

  function setText(selector: string, value: string) {
    const element = document.querySelector(selector);
    if (element) element.textContent = value;
  }

  function setAllText(selector: string, value: string) {
    document.querySelectorAll(selector).forEach((element) => {
      element.textContent = value;
    });
  }

  function formatHeroMetadata(dateKey: string) {
    const label = heroMetadata instanceof HTMLElement ? heroMetadata.dataset.metadataLabel || "" : "";
    const locale = heroMetadata instanceof HTMLElement ? heroMetadata.dataset.metadataLocale || "en" : "en";
    const [, month = "", day = ""] = dateKey.split("-");
    const monthLabels = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];
    const formattedDate = locale === "zh-CN" ? `${month}.${day}` : `${monthLabels[Number(month) - 1] || month} ${day}`;
    return `${label} · ${formattedDate}`;
  }

  function replaceList(selector: string, values: string[], tagName: "li" | "span") {
    const list = document.querySelector(selector);
    if (!list) return;

    list.replaceChildren(
      ...values.map((value) => {
        const item = document.createElement(tagName);
        item.textContent = value;
        return item;
      }),
    );
  }

  function configureHeroTitle() {
    if (!(heroTitle instanceof HTMLElement)) return;

    heroTitle.style.removeProperty("--hero-title-size");
    scheduleFitHeroTitle();
  }

  function scheduleFitHeroTitle() {
    window.cancelAnimationFrame(heroTitleFrame);
    heroTitleFrame = window.requestAnimationFrame(fitHeroTitle);
  }

  function fitHeroTitle() {
    if (!(heroTitle instanceof HTMLElement)) return;

    const maxLines = getHeroTitleLineLimit(heroTitle);
    const minFontSize = getMinimumHeroTitleSize();

    heroTitle.style.removeProperty("--hero-title-size");
    let fontSize = Number.parseFloat(getComputedStyle(heroTitle).fontSize);
    heroTitle.style.setProperty("--hero-title-size", `${fontSize}px`);

    while (fontSize > minFontSize && !isHeroTitleFit(heroTitle, maxLines)) {
      fontSize -= 2;
      heroTitle.style.setProperty("--hero-title-size", `${Math.max(fontSize, minFontSize)}px`);
    }
  }

  function scrollToRecipe() {
    if (!(scrollRecipe instanceof HTMLElement)) return;
    const targetId = scrollRecipe.dataset.scrollTarget || "";
    const target = targetId ? document.getElementById(targetId) : null;
    if (!target) return;

    target.scrollIntoView({
      behavior: window.matchMedia("(prefers-reduced-motion: reduce)").matches ? "auto" : "smooth",
      block: "start",
    });
    scrollRecipe.blur();
  }

  function getHeroTitleLineLimit(title: HTMLElement) {
    const rawValue = getComputedStyle(title).getPropertyValue("--hero-title-lines");
    const lineLimit = Number.parseInt(rawValue, 10);

    return Number.isFinite(lineLimit) && lineLimit > 0 ? lineLimit : 1;
  }

  function isHeroTitleFit(title: HTMLElement, maxLines: number) {
    const styles = getComputedStyle(title);
    const fontSize = Number.parseFloat(styles.fontSize);
    const lineHeight = Number.parseFloat(styles.lineHeight) || fontSize;
    const lineCount = Math.ceil(title.getBoundingClientRect().height / lineHeight);

    return title.scrollWidth <= title.clientWidth + 1 && lineCount <= maxLines;
  }

  function getMinimumHeroTitleSize() {
    if (window.innerWidth <= 560) return 24;
    if (window.innerWidth <= 860) return 30;
    return 42;
  }

</script>
